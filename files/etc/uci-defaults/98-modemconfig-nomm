#!/bin/sh

# check soft upgrade
[ -f /etc/.config.lock ] && exit 0

# check modemmanager
[ -x /usr/bin/mmcli ] && exit 0

. /usr/share/mmconfig-functions

board="$(cat /tmp/sysinfo/board_name)"
RES=/usr/share/modeminfo/modem.list
SMS_CONFIGURED=0


# ============================================================
# XMMCONFIG
# Fibocom L850/L860/FM350 via xmm proto
# ============================================================

log_xmm_found(){
	local smsport="${device%?}$((${device: -1}+2))"

	logger -t "$NODE" \
		"Found: $FAMILY (${vid}:${pid}) -> $ifmodemname data: /dev/${device}"

	[ -n $smsport ] && {
		logger -t "$NODE" "Ports at: /dev/${device} sms: /dev/${smsport}"
	} || {
		logger -t "$NODE" "Ports at: /dev/${device}"
	}
}

xmm_uci_config(){
	APN=internet

	[ "$FAILED" = "--" ] && ENABLED=1 || ENABLED=0

	setup_iface xmm /dev/${device}
	setup_modeminfo "$device"
	setup_pingcontrol
}

xmm_smstools_uci_config(){
	local smsport="${device%?}$((${device: -1}+2))"

	setup_smstools3 "$smsport"

	uci set smstools3.$ifmodemname.net_check='0'
	uci set smstools3.$ifmodemname.sig_check='1'
}

check_sim(){
	gcom -d /dev/${device} -s /etc/gcom/setpin.gcom \
		> /dev/null 2>&1 && FAILED="--" || FAILED=OK
}

get_tty_vidpid(){
	local dev_name="$1"

	vid=""
	pid=""
	interface=""

	[ -e "/sys/class/tty/${dev_name}" ] || return 1

	local tty_path
	tty_path=$(readlink -f "/sys/class/tty/${dev_name}" 2>/dev/null)

	local cur="$tty_path"
	local iface_path=""

	while [ -n "$cur" ] && [ "$cur" != "/" ]; do
		[ -f "${cur}/bInterfaceNumber" ] && {
			iface_path="$cur"
			break
		}

		cur=$(dirname "$cur")
	done

	[ -n "$iface_path" ] || return 1

	local usb_path
	usb_path=$(dirname "$iface_path")

	while [ -n "$usb_path" ] && [ "$usb_path" != "/" ]; do
		[ -f "${usb_path}/idVendor" ] &&
		[ -f "${usb_path}/idProduct" ] && break

		usb_path=$(dirname "$usb_path")
	done

	[ -n "$usb_path" ] &&
	[ "$usb_path" != "/" ] || return 1

	vid=$(cat "${usb_path}/idVendor" 2>/dev/null)
	pid=$(cat "${usb_path}/idProduct" 2>/dev/null)
	interface=$(cat "${iface_path}/bInterfaceNumber" 2>/dev/null)

	return 0
}

get_usb_info(){
	device="$1"

	get_tty_vidpid "$device" || return 1

	case ${vid}${pid} in
		8087095a)
			case $interface in
				00)
					FAMILY="Fibocom L850/L860 NCM Modem"

					make_ifname
					mn=$((mn+1))
					MWAN_IFACES="$MWAN_IFACES $ifmodemname"

					check_sim
					xmm_uci_config
					xmm_smstools_uci_config

					log_xmm_found
				;;
			esac
		;;

		0e8d7126)
			FAMILY="Fibocom FM350 NCM Modem"

			case $interface in
				04)
					make_ifname
					mn=$((mn+1))
					MWAN_IFACES="$MWAN_IFACES $ifmodemname"

					check_sim
					xmm_uci_config

					log_xmm_found
				;;
			esac
		;;

		0e8d7127)
			FAMILY="Fibocom FM350 NCM Modem"

			case $interface in
				06)
					make_ifname
					mn=$((mn+1))
					MWAN_IFACES="$MWAN_IFACES $ifmodemname"

					check_sim
					xmm_uci_config

					log_xmm_found
				;;
			esac
		;;
	esac

	return 0
}

xmm_stuff(){
	default_setup

	found_devices=0

	for dev_base in ttyUSB ttyACM; do
		dev_num=0

		while true; do
			dev="/dev/${dev_base}${dev_num}"

			if [ -e "$dev" ]; then
				device_name="${dev_base}${dev_num}"

				if get_usb_info "$device_name"; then
					found_devices=$((found_devices + 1))
				fi

				dev_num=$((dev_num + 1))
			else
				if [ "$dev_num" -eq 0 ]; then
					for alt_dev in "/dev/${dev_base}"*; do
						if [ -e "$alt_dev" ] &&
						   [ "$alt_dev" != "/dev/${dev_base}*" ]; then

							device_name=$(basename "$alt_dev")

							if get_usb_info "$device_name"; then
								found_devices=$((found_devices + 1))
							fi
						fi
					done
				fi

				break
			fi
		done
	done
}


# ============================================================
# CDC-WDM
#
# QMI:
#   qmi_wwan -> uqmi
#
# MBIM:
#   cdc_mbim -> umbim
#
# AT/SMS ports are detected dynamically with probeport.gcom.
# ============================================================

check_mm(){
	[ -x /usr/bin/mmcli ] && {
		STATUS=$(
			/etc/init.d/modemmanager status > /dev/null 2>&1
			echo $?
		)

		case $STATUS in
			0)
				stop_services modemmanager
			;;
		esac
	}
}


# ------------------------------------------------------------
# Find all ttyUSB/ttyACM ports belonging to the same USB
# device as the current cdc-wdm device.
# ------------------------------------------------------------

get_modem_tty_ports(){
	local usb_path
	local tty
	local tty_name
	local tty_path

	usb_path=$(readlink -f \
		"/sys/class/usbmisc/${d}/../../../" \
		2>/dev/null)

	[ -n "$usb_path" ] || return 1

	for tty in /dev/ttyUSB* /dev/ttyACM*; do
		[ -e "$tty" ] || continue

		tty_name="${tty#/dev/}"

		tty_path=$(readlink -f \
			"/sys/class/tty/${tty_name}" \
			2>/dev/null)

		[ -n "$tty_path" ] || continue

		case "$tty_path" in
			"$usb_path"/*)
				echo "$tty_name"
			;;
		esac
	done
}


# ------------------------------------------------------------
# Probe modem serial ports.
#
# /etc/gcom/probeport.gcom returns:
#
#   0 = AT port, SIM OK
#   1 = not an AT port
#   2 = AT port, SIM error
#
# First responding port -> ATPORT
# Second responding port -> SMSPORT
#
# If only one AT port exists, SMSPORT remains empty.
# ------------------------------------------------------------

probe_modem_ports(){
	local port
	local result

	ATPORT=""
	SMSPORT=""
	SIM="not-ready"

	for port in $(get_modem_tty_ports); do
		DEVPORT="/dev/${port}" \
			gcom -s /etc/gcom/probeport.gcom \
			> /dev/null 2>&1

		result=$?

		case $result in
			0|2)
				if [ -z "$ATPORT" ]; then
					ATPORT="$port"

					[ "$result" -eq 0 ] &&
						SIM="ready"

					logger -t "$NODE" \
						"Found AT port: /dev/${ATPORT}"
				elif [ -z "$SMSPORT" ]; then
					SMSPORT="$port"

					logger -t "$NODE" \
						"Found SMS port: /dev/${SMSPORT}"
				fi
			;;
		esac

		[ -n "$ATPORT" ] &&
		[ -n "$SMSPORT" ] &&
			break
	done

	[ -n "$ATPORT" ] || return 1

	return 0
}


# ------------------------------------------------------------
# QMI: get serving PLMN
#
# Sets:
#   MCC
#   MNC
# ------------------------------------------------------------

qmi_get_info(){
	local device="$1"
	local result

	MCC=""
	MNC=""

	result=$(
		uqmi -d "$device" --get-serving-system 2>/dev/null
	)

	eval "$(
		echo "$result" |
			jsonfilter \
				-e "MCC=$['plmn_mcc']" \
				-e "MNC=$['plmn_mnc']"
	)"

	return 0
}


# ------------------------------------------------------------
# MBIM: get current/home provider
#
# Sets:
#   MCC
#   MNC
# ------------------------------------------------------------

mbim_get_info(){
	local device="$1"
	local registration
	local provider_id

	MCC=""
	MNC=""

	registration=$(
		umbim -d "$device" registration 2>/dev/null
	)

	provider_id=$(
		echo "$registration" |
			awk -F ': ' '
				/^[[:space:]]*provider_id:/ {
					print $2
				}
			'
	)

	case "$provider_id" in
		""|"null"|"(null)")
			provider_id=""
		;;
	esac

	if [ -n "$provider_id" ]; then
		MCC=$(echo "$provider_id" | cut -c1-3)
		MNC=$(echo "$provider_id" | cut -c4-)

		logger -t "$NODE" \
			"MBIM modem ${device} registered on PLMN ${MCC}${MNC}"

		return 0
	fi

	registration=$(
		umbim -d "$device" home 2>/dev/null
	)

	provider_id=$(
		echo "$registration" |
			awk -F ': ' '
				/^[[:space:]]*provider_id:/ {
					print $2
				}
			'
	)

	case "$provider_id" in
		""|"null"|"(null)")
			logger -t "$NODE" \
				"MBIM modem ${device}: no PLMN information"

			return 0
		;;
	esac

	MCC=$(echo "$provider_id" | cut -c1-3)
	MNC=$(echo "$provider_id" | cut -c4-)

	logger -t "$NODE" \
		"MBIM modem ${device}: using home PLMN ${MCC}${MNC}"

	return 0
}


# ------------------------------------------------------------
# Unified modem information
# ------------------------------------------------------------

get_modem_info(){
	local driver="$1"
	local device="$2"

	MCC=""
	MNC=""

	case "$driver" in
		qmi)
			qmi_get_info "$device"
		;;

		mbim)
			mbim_get_info "$device"
		;;

		*)
			logger -t "$NODE" \
				"Unknown modem protocol: $driver"

			return 1
		;;
	esac
}


# ------------------------------------------------------------
# Detect CDC-WDM protocol driver
# ------------------------------------------------------------

get_cdc_wdm_driver(){
	local device="$1"
	local driver_path

	driver_path=$(
		readlink -f \
			"/sys/class/usbmisc/${device}/../../driver" \
			2>/dev/null
	)

	case "$driver_path" in
		*/qmi_wwan)
			echo qmi
		;;

		*/cdc_mbim)
			echo mbim
		;;

		*)
			return 1
		;;
	esac
}


# ------------------------------------------------------------
# Configure one QMI/MBIM modem
# ------------------------------------------------------------

setup_cdc_wdm_modem(){
	local d="$1"
	local driver="$2"

	VID=$(
		cat "$(
			readlink -f \
				"/sys/class/usbmisc/${d}/../../../idVendor"
		)" 2>/dev/null
	)

	PID=$(
		cat "$(
			readlink -f \
				"/sys/class/usbmisc/${d}/../../../idProduct"
		)" 2>/dev/null
	)

	[ -n "$VID" ] || return 1
	[ -n "$PID" ] || return 1

	[ -r "$RES" ] || {
		logger -t "$NODE" \
			"Modem database not found: $RES"

		return 1
	}

	FAMILY=$(
		awk -F '[;]' \
			'/'${VID}${PID}'/{print toupper($2)}' \
			"$RES"
	)

	[ -n "$FAMILY" ] || {
		logger -t "$NODE" \
			"Unknown modem: ${VID}:${PID}"

		return 1
	}

	DEVICE="/dev/${d}"

	#
	# Find AT and SMS ports dynamically.
	#
	probe_modem_ports || {
		logger -t "$NODE" \
			"No AT ports found for ${DEVICE} (${VID}:${PID})"

		return 1
	}

	make_ifname
	mn=$((mn+1))

	log_modem_found

	#
	# SIM state was obtained by probeport.gcom.
	# QMI/MBIM is only used for PLMN.
	#
	get_modem_info "$driver" "$DEVICE"

	[ "$SIM" = "ready" ] || log_sim_missing

	if [ -n "$MCC" ] && [ -n "$MNC" ]; then
		resolve_apn "${MCC}${MNC}"
	else
		logger -t "$NODE" \
			"Unable to determine PLMN for ${DEVICE}; using APN fallback"

		resolve_apn ""
	fi

	[ "$SIM" = "ready" ] && ENABLED=1 || ENABLED=0

	setup_iface "$driver" "$DEVICE"
	setup_modeminfo "$ATPORT"
	setup_pingcontrol

	#
	# SMS port is optional.
	#
	[ -n "$SMSPORT" ] &&
		setup_smstools3 "$SMSPORT"

	MWAN_IFACES="$MWAN_IFACES $ifmodemname"

	return 0
}


# ------------------------------------------------------------
# Detect and configure all CDC-WDM modems
# ------------------------------------------------------------

cdc_wdm_device(){
	local d
	local driver

	CDC_WDM_DEV=""

	#
	# Only actual cdc-wdm devices.
	#
	for d in /sys/class/usbmisc/cdc-wdm*; do
		[ -e "$d" ] || continue
		CDC_WDM_DEV="$CDC_WDM_DEV ${d##*/}"
	done

	[ -n "$CDC_WDM_DEV" ] || {
		logger -t "$NODE" \
			"WARNING: CDC-WDM modems not found in system"

		return 1
	}

	default_setup

	for d in $CDC_WDM_DEV; do
		driver=$(get_cdc_wdm_driver "$d")

		case "$driver" in
			qmi)
				[ -x /sbin/uqmi ] || {
					logger -t "$NODE" \
						"WARNING: UQMI not found, skipping ${d}"

					continue
				}
			;;

			mbim)
				[ -x /sbin/umbim ] || {
					logger -t "$NODE" \
						"WARNING: UMBIM not found, skipping ${d}"

					continue
				}
			;;

			*)
				logger -t "$NODE" \
					"Device /dev/${d} has unsupported driver. Skip."

				continue
			;;
		esac

		setup_cdc_wdm_modem "$d" "$driver"

		unset ATPORT
		unset SMSPORT
		unset FAMILY
		unset VID
		unset PID
		unset DRIVER
		unset DEVICE
		unset MCC
		unset MNC
		unset SIM
	done
}




# ============================================================
# DETECT — count modems
# ============================================================

count_cdc_wdm_modems(){
	CDC_WDM_COUNT=0

	for d in /sys/class/usbmisc/cdc-wdm*; do
		[ -e "$d" ] || continue
		CDC_WDM_COUNT=$((CDC_WDM_COUNT + 1))
	done
}

count_xmm_modems(){
	XMM_COUNT=0

	for tty_base in ttyUSB ttyACM; do
		dev_num=0

		while true; do
			[ -e "/dev/${tty_base}${dev_num}" ] || break

			if get_tty_vidpid "${tty_base}${dev_num}"; then
				case ${vid}${pid} in
					8087095a)
						[ "$interface" = "00" ] &&
							XMM_COUNT=$((XMM_COUNT + 1))
					;;

					0e8d7126)
						[ "$interface" = "04" ] &&
							XMM_COUNT=$((XMM_COUNT + 1))
					;;

					0e8d7127)
						[ "$interface" = "06" ] &&
							XMM_COUNT=$((XMM_COUNT + 1))
					;;
				esac
			fi

			dev_num=$((dev_num + 1))
		done
	done
}

count_modems(){
	count_cdc_wdm_modems
	count_xmm_modems

	TOTAL_MODEMS=$((CDC_WDM_COUNT + XMM_COUNT))
}


# ============================================================
# MAIN
# ============================================================

do_run(){
	MWAN_IFACES=""
	mn=1
	SMS_CONFIGURED=0

	#
	# Count all supported modems before configuration.
	#
	count_modems

	#
	# Nothing found
	#
	if [ "$TOTAL_MODEMS" -eq 0 ]; then
		logger -t "$NODE" \
			"No supported modems were found"

		return 0
	fi

	logger -t "$NODE" \
		"Detected $TOTAL_MODEMS modem(s)"

	#
	# QMI / MBIM
	#
	if [ "$CDC_WDM_COUNT" -gt 0 ]; then

		check_mm

		#
		# The script is already started after 120/240 seconds.
		# Give USB/netifd a small additional moment to settle.
		#
		sleep 10

		cdc_wdm_device
	fi

	#
	# XMM
	#
	if [ "$XMM_COUNT" -gt 0 ]; then

		xmm_stuff
	fi

	sleep 35

	uci commit
	reload_config

	if [ "$SMS_CONFIGURED" -eq 0 ]; then
		stop_services smstools3 luci-sms

		logger -t "$NODE" \
			"WARNING: No SMS ports configured"

		logger -t "$NODE" \
			"WARNING: SMS messaging functionality disabled."

		logger -t "$NODE" \
			"WARNING: Please manually configure service."
	fi

	[ -x /etc/init.d/fixmodem ] &&
		/etc/init.d/fixmodem disable

	if [ "$mn" -eq "1" ]; then
		logger -t "$NODE" \
			"WARNING: Any installed modems not supported by autoconfiguration."

		logger -t "$NODE" \
			"WARNING: Mobile services is stopped."

		logger -t "$NODE" \
			"WARNING: Please manually configure it."

		stop_services smstools3 luci-sms
	else
		logger -t "$NODE" \
			"Modem interface(s) setup complete."
	fi

	setup_mwan3
}


# ============================================================
# START DELAY
# ============================================================

SLEEP=120

[ -f /etc/openwrt_release ] && {
	. /etc/openwrt_release

	case $DISTRIB_TARGET in
		*mt76x8*|*mt7620*|*ath79*)
			SLEEP=240
		;;
	esac
}

sleep $SLEEP && do_run &